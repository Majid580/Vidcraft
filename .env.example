# Copy this file to backend/.env (and ai-service/.env once needed) and
# fill in real values there. Never commit a file with real secrets —
# .env is gitignored project-wide.
# Source of truth for this list: PROJECT_ARCHITECTURE.md Section 13.

# --- Database ---
MONGODB_URI=mongodb://localhost:27017/vidcraft   # local Docker Compose default (docker-compose.yml)
REDIS_URL=redis://localhost:6379   # BACKEND-003: this machine runs Redis inside WSL2 (`sudo apt install redis-server`, per the same WSL2 pattern as ADR-008), reachable from Windows via WSL2 port forwarding

# --- Primary LLM ---
GROQ_API_KEY=<API_KEY>        # required, primary agent-orchestration inference
GROQ_MODEL=llama-3.3-70b-versatile   # confirmed working model id, chosen in AI-003 (see ADR-011)

# --- Fallback LLM (AI-006, ADR-015: hosted OpenAI-compatible API, never local) ---
# Used only when Groq (primary) is unavailable (429/5xx/connection/no-key).
# Defaults (in ai-service/config.py) point at a SECOND Groq model on the same
# free key — zero cost, no extra signup. Override any of the three below to use
# a fully independent provider (OpenRouter, Together, Gemini OpenAI-compat, OpenAI, ...).
LLM_FALLBACK_ENABLED=true                          # false -> Groq failures are fatal
FALLBACK_LLM_BASE_URL=https://api.groq.com/openai/v1   # OpenAI-compatible /chat/completions base
FALLBACK_LLM_API_KEY=                              # blank -> reuse GROQ_API_KEY
FALLBACK_LLM_MODEL=llama-3.1-8b-instant            # different per-model rate bucket than the primary
LLM_TIMEOUT_SECONDS=60

# --- External video/image generation (PROVIDER-001, ADR-019) ---
# Tier 1 (free, active, credentials live-validated 2026-08-11).
# Image: Pollinations.ai needs NO key/account — it's a public URL API
# (https://image.pollinations.ai/prompt/{text}) — nothing to set. Cloudflare
# Workers AI is a validated alternate image provider (real text-to-image
# catalog confirmed live: FLUX.1/FLUX.2, SDXL, Leonardo Phoenix) — no credit
# card needed: https://dash.cloudflare.com
CLOUDFLARE_ACCOUNT_ID=<ACCOUNT_ID>
CLOUDFLARE_API_TOKEN=<API_TOKEN>
# Video: Hugging Face Inference Providers — NOT a fallback, this is the actual
# Tier 1 video provider. Cloudflare Workers AI has no video-generation model
# in its real catalog (checked live against Cloudflare's own API — initial
# research had suggested otherwise and was wrong, corrected same day, see
# ADR-019). https://huggingface.co/settings/tokens
# BACKEND-005 note: default model is Wan-AI/Wan2.1-T2V-1.3B via the fal-ai
# backend (cheapest text-to-video option, to conserve free monthly router
# credits) — see backend/src/services/providers/huggingfaceVideo.js. As of
# 2026-08-11 this account's monthly credits are already depleted; adapter
# code is verified correct up to that billing rejection, but no real video
# has been generated yet (see PROJECT_ARCHITECTURE.md Section 6.6 / R-8).
HUGGINGFACE_API_TOKEN=<API_TOKEN>

# --- Cross-shot continuity (FR-7) ---
# How a storyboard's shots are kept visually consistent with each other.
# The base tier needs no configuration: every shot's prompt is built from the
# storyboard's world_state (same subject/location/style block, byte-identical
# across shots) with a deterministic per-shot seed — see
# backend/src/services/continuityPrompt.js.
#
# Reference anchoring (img2img) is an optional third tier: the first frame a
# storyboard generates is reused as an img2img reference for the remaining
# shots. Cloudflare only — Pollinations' img2img needs a publicly-reachable
# URL and generated assets live on this server's local /media mount.
#
# DEFAULT OFF, based on a live measured comparison (2026-08-12), not on
# theory: anchoring freezes composition as well as subject, so a wide, a
# medium and a close-up all rendered as the same standing pose — which
# defeats the point of a storyboard. Prompt+seed continuity alone held the
# subject, wardrobe and location steady AND produced correctly varying
# framing, at 1024x1024 and ~2.2s/shot vs ~6s anchored. Set to true only to
# reproduce the anchored condition for the FR-12 evaluation.
CONTINUITY_REFERENCE_ANCHORING=false
# img2img anchoring dial, 0-1. Cloudflare's semantics: LOWER keeps the output
# closer to the reference. Live sweep found no value that gives both identity
# and compositional freedom: 0.65/0.75 copy the reference's composition
# wholesale; 0.95 changes wardrobe colour, loses the setting, and can put a
# second person in frame. 0.75 is the least-bad setting, not a good one.
CONTINUITY_STRENGTH=0.75
# Optional: pin Pollinations to a specific model for full run-to-run
# reproducibility. Unset uses Pollinations' own default (what PROVIDER-001
# live-validated).
POLLINATIONS_MODEL=

# Tier 2/3 (paid) — NOT wired up yet; team chose free-only while testing
# (ADR-019). fal.ai is the selected single gateway for when these are
# enabled (one key, many models: LTX/Wan for Tier2, Kling/Veo for Tier3).
FAL_API_KEY=<API_KEY>             # not yet consumed by any code path

# --- Optional TTS (stretch feature only) ---
TTS_API_KEY=<API_KEY>             # TBD provider, optional

# --- Cloud media storage (provider TBD) ---
CLOUD_STORAGE_KEY=<API_KEY>
CLOUD_STORAGE_BUCKET=

# --- App config ---
PORT=5000                     # backend server port
NODE_ENV=development           # development | production
AI_SERVICE_URL=http://localhost:8000   # internal URL for backend -> AI microservice calls
# Where Remotion's headless browser fetches generated stills from during
# FR-9 video assembly. Defaults to http://localhost:${PORT}, correct while
# the API and the generation queue share one process; set this if the worker
# is ever split onto its own host.
MEDIA_BASE_URL=http://localhost:5000

# --- AI microservice config ---
VECTOR_INDEX_PATH=rag/data/style_index   # RAG-001: base path; store writes {path}.faiss + {path}.meta.json
EMBEDDING_MODEL=all-MiniLM-L6-v2   # RAG-001/FR-4: corpus + query encoder (384-dim)
RAG_TOP_K=3                    # RAG-001/FR-4: default k for style retrieval
CRITIC_MAX_RETRIES=2           # confirmed default per proposal §6.7 -- read by backend/ (the loop lives in criticService.js)
STORYBOARD_SIMILARITY_THRESHOLD=0.35  # confirmed default per ADR-018 (max 2 retries)
ANALYSIS_SCORE_THRESHOLD=60    # confirmed default per proposal §6.1 ("default: 60/100")

# --- Critic vision model (CRITIC-001, ADR-026) ---
# ai-service holds its own copy of the SAME Cloudflare credentials as the
# "External video/image generation" section above (separate process, no
# shared env — mirrors GROQ_API_KEY). Groq's live catalog has no
# vision-capable models, checked directly; Cloudflare's llama-4-scout does,
# needs no gated per-model license click-through unlike llama-3.2-vision.
CLOUDFLARE_ACCOUNT_ID=<ACCOUNT_ID>
CLOUDFLARE_API_TOKEN=<API_TOKEN>
CRITIC_VISION_MODEL=@cf/meta/llama-4-scout-17b-16e-instruct

# --- Narration / voiceover (NARR-001, FR-10, ADR-032) ---
# Every video-generation model in this project's reach returns SILENT video
# (Runway, Pika, Luma, Kling, Stable Video Diffusion, the Hugging Face
# text-to-video models); native audio exists only in Veo 3 / Sora 2, neither
# of which is in PROVIDER-001's tiers. So the voiceover is synthesised after
# generation and the VIDEO IS FITTED TO THE AUDIO: each line is spoken first,
# its real length measured, and the shot held for exactly that long. Drift is
# structurally absent rather than corrected.
# Tier 1 is Edge TTS -- hosted (so ADR-015's no-local-inference rule holds),
# free, and needing no key or signup, which is why nothing is configured here.
# Set NARRATION_ENABLED=false to render silent videos exactly as before.
NARRATION_ENABLED=true
# Any Edge TTS voice id, e.g. en-US-GuyNeural, en-US-JennyNeural,
# en-GB-RyanNeural. Blank uses the module default (en-US-GuyNeural).
NARRATION_VOICE=
